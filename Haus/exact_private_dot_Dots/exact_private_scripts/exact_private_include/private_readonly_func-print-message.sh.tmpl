# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=sh: */ -'@}

{@' includeTemplate .tmpl.shebang.dumbSh . '@}
#
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
#
# This file is intended to be sourced in scripts from
# the .chezmoiscripts directory and others
#
# It adds following functions to print coloured messages:
#
# vbd_Print_Message <message> - prints a message with newline
# vbd_Print_Message_NLB <message> - prints a message without newline
# vbd_Print_Header <message> - prints a message in a bold color starting from a newline
#

{@' $colorDefault := "\\033[00m" -'@}
{@' $colorMessage := "\\033[00;36m" -'@}
{@' $colorHeader := "\\033[01;35m" -'@}

vbd_Print_Message_NLB() {
	printf "{@' $colorMessage '@}${1}{@' $colorDefault '@}"
}

vbd_Print_Message() {
	vbd_Print_Message_NLB "${1}"
	printf "\n"
}

vbd_Print_Header() {
	printf "\n{@' $colorHeader '@}${1}{@' $colorDefault '@}\n"
}
