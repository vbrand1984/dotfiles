# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=yaml fdm=marker: */ -'@}

{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

- name: Ensure that directories for config files exist
  tags: [system, files, system_config]
  become: true
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: '0755'
  loop: "{{ vbd_system_files_dir_list }}"

- name: Install sysctl config files
  tags: [system, files, system_config]
  become: true
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: "{{ item.mode if item.mode is defined else '644' }}"
  loop: "{{ vbd_system_files_conf_list }}"

...
