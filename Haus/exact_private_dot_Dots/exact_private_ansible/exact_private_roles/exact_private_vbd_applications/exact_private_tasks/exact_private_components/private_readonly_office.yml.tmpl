# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=yaml fdm=marker: */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

- name: Office apps | Install packages
  become: true
  when: ansible_facts['os_family'] == 'Debian'
  block:

    - name: Office apps | Install packages (stable)
      ansible.builtin.apt:
        package: "{{ vbd_applications_pkgs_office['deb_stable'] }}"
        state: present
        install_recommends: false

    - name: Office apps | Install packages (backports)
      ansible.builtin.apt:
        package: "{{ vbd_applications_pkgs_office['deb_backports'] }}"
        default_release: "{{ ansible_facts['distribution_release'] }}-backports"
        state: latest # noqa: package-latest
        install_recommends: false

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

- name: Office apps | Install packages (xbps)
  become: true
  community.general.xbps:
    package: "{{ vbd_applications_pkgs_office['xbps'] }}"
    state: present
  when: ansible_facts['distribution'] == 'Void'

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
