# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* {{{ Vim modeline for the template (YAML) */ -'@}
{@'- if false -'@}
# vim: set ft=yaml:
{@'- end -'@} {@'- /* }}} */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

vbd_applications_default_terminal: {@' .cmd.terminalEmulator | squote '@}
vbd_applications_default_file_manager: {@' .cmd.fileManager | squote '@}

vbd_applications_pkgs_desktop_utils:
{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

  deb_stable:
    - alacritty
    - caja
    - conky-std
    - dconf-editor
    - dunst
    - emacs-pgtk
    - engrampa
    - firejail
    - firejail-profiles
    - geany
    - gsimplecal
    - network-manager-applet
    - qalculate-gtk
    - rofi
    - udiskie

    # IDK whether it should be here
    # But nothing pulls it automatically for whatever reason
    - libnotify-bin

    # Debian-based-specific
    - gdebi
    - lintian

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

  xbps:
    - alacritty
    - caja
    - dconf-editor
    - emacs-pgtk
    - engrampa
    - firejail
    - geany
    - gsimplecal-gtk3
    - mime-types
    - network-manager-applet
    - qalculate-gtk
    - rofi
    - rofi-calc
    - udiskie

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
