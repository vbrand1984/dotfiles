# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* {{{ Vim modeline for the template (YAML) */ -'@}
{@'- if false -'@}
# vim: set ft=yaml:
{@'- end -'@} {@'- /* }}} */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

- name: Network services | Install packages (stable)
  tags: [packages, system, network, network_services]
  become: true
  ansible.builtin.apt:
    package: "{{ vbd_system_base_pkgs_network_services.deb_stable }}"
    state: present
    install_recommends: false

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

- name: Network services | Install packages (xbps)
  tags: [packages, system, network, network_services]
  become: true
  community.general.xbps:
    package: "{{ vbd_system_base_pkgs_network_services.xbps }}"
    state: present

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
