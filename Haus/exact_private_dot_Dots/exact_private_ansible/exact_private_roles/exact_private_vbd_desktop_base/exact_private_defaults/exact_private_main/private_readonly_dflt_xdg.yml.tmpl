# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* {{{ Vim modeline for the template (YAML) */ -'@}
{@'- if false -'@}
# vim: set ft=yaml:
{@'- end -'@} {@'- /* }}} */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

vbd_desktop_base_pkgs_xdg:
{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

  deb_stable:
    - xdg-desktop-portal
    - xdg-desktop-portal-gtk
    - xdg-desktop-portal-wlr
    - xdg-user-dirs
    - xdg-utils

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

  xbps:
    - xdg-desktop-portal
    - xdg-desktop-portal-gtk
    - xdg-desktop-portal-wlr
    - xdg-user-dirs
    - xdg-utils

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
