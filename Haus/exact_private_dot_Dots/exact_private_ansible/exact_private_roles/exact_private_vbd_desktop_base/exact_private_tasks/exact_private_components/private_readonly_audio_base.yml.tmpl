# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=yaml fdm=marker: */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

- name: Audio base | Install packages
  become: true
  when: ansible_facts['os_family'] == 'Debian'
  block:

    - name: Audio Base | Ensure that Pulseaudio is not installed (apt)
      become: true
      ansible.builtin.apt:
        package: pulseaudio
        state: absent
        purge: true

    - name: Audio Base | Install ALSA (stable)
      ansible.builtin.apt:
        package: "{{ vbd_desktop_base_pkgs_audio_base.alsa['deb_stable'] }}"
        state: present
        install_recommends: false
      notify: Run alsactl init

    - name: Audio Base | Install PipeWire (stable)
      ansible.builtin.apt:
        package: "{{ vbd_desktop_base_pkgs_audio_base.pipewire['deb_stable'] }}"
        state: present
        install_recommends: false
      when:
        - vbd_desktop_base_pkgs_audio_base.pipewire.deb_stable is defined
        - vbd_desktop_base_pkgs_audio_base.pipewire.deb_stable | length > 0

    - name: Audio Base | Install PipeWire (backports)
      ansible.builtin.apt:
        package: "{{ vbd_desktop_base_pkgs_audio_base.pipewire['deb_backports'] }}"
        default_release: "{{ ansible_facts['distribution_release'] }}-backports"
        state: latest # noqa: package-latest
        install_recommends: false
      when:
        - vbd_desktop_base_pkgs_audio_base.pipewire.deb_backports is defined
        - vbd_desktop_base_pkgs_audio_base.pipewire.deb_backports | length > 0

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

- name: Audio base | Install packages
  become: true
  when: ansible_facts['distribution'] == 'Void'
  block:

    - name: Audio Base | Ensure that PulseAudio is not installed (xbps)
      community.general.xbps:
        name: pulseaudio
        state: absent

    - name: Audio Base | Install ALSA (xbps)
      community.general.xbps:
        name: "{{ vbd_desktop_base_pkgs_audio_base.alsa['xbps'] }}"
        state: present
      notify: Run alsactl init

    - name: Audio Base | Install PipeWire (xbps)
      community.general.xbps:
        name: "{{ vbd_desktop_base_pkgs_audio_base.pipewire['xbps'] }}"
        state: present

    - name: Audio Base | Apply ALSA and PipeWire system configuration
      ansible.builtin.file:
        dest: "{{ item.dest }}"
        src: "{{ item.src if item.src is defined else '' }}"
        state: "{{ item.state }}"
        mode: "{{ '755' if item.state == 'directory' else '' }}"
        owner: root
        group: root
      loop: "{{ vbd_desktop_base_void_audio_conf }}"

{@'- end '@} {@'- /* }}} */'@}
{@'- /* {{{ Common ground for systemd: establish rtkit config */'@}
{@'- if .sys.hasSystemd '@}

- name: Audio base | rtkit systemd configuration
  become: true
  when: ansible_facts['service_mgr'] == 'systemd'
  block:

    - name: Audio base | Create directory for rtkit systemd configuration
      ansible.builtin.file:
        path: '/lib/systemd/system/rtkit-daemon.service.d'
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Audio base | Create rtkit configuration file for systemd
      ansible.builtin.copy:
        dest: '/lib/systemd/system/rtkit-daemon.service.d/vbd-rtkit-LogLevelMax.conf'
        content: |
          [Service]
          LogLevelMax=4
        owner: root
        group: root
        mode: '0644'

{@'- end '@} {@'- /* }}}*/'@}

...
{@'- end '@}
