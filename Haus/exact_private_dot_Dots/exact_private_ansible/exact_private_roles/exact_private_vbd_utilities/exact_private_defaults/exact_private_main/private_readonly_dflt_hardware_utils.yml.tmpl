# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=yaml fdm=marker: */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

vbd_utilities_pkgs_hardware_utils:
{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

  deb_stable:
    - cpuid
    - cpuinfo
    - dmidecode
    - hwinfo
    - inxi
    - lm-sensors
    - lshw
    - lsscsi
    - pciutils
    - smartmontools
    - usbutils

    # Hardware monitors
    - btop
    - glances
    - htop
    - iotop

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

  xbps:
    - cpuid
    - cpuinfo
    - dmidecode
    - hwinfo
    - inxi
    - lm_sensors
    - lshw
    - lsscsi
    - pciutils
    - smartmontools
    - usbutils

    # Hardware monitors
    - btop
    - glances
    - htop
    - iotop

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
