# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* {{{ Vim modeline for the template (YAML) */ -'@}
{@'- if false -'@}
# vim: set ft=yaml:
{@'- end -'@} {@'- /* }}} */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

vbd_utilities_pkgs_distro_specific:
{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

  deb_stable:
{@'- if and .sys.isBrandsPrivate (ne .dir.userData .dir.userDataDefault) '@}
    - btrfsmaintenance
{@'- end '@}
    - command-not-found
    - devscripts # for checkbashisms mainly
    - hodie
    - python3-apt
#    - python3-debian # backported
    - python-is-python3
    - vrms

  deb_backports:
    - python3-debian

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

  xbps:
    - checkbashisms
    - vsv
    - xtools

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
