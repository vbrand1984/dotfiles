# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=yaml fdm=marker: */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- if not .sys.isDevuan '@}

{@'- $devuanCurrent := (get .file.devuanKeyring .file.devuanKeyring.current) '@}
vbd_utilities_devuan_keyring_deb: {@' joinPath .chezmoi.homeDir .dir.downloaded (printf .file.devuanKeyring.pattern $devuanCurrent.ver) | squote '@}

{@'- end '@}

vbd_utilities_pkgs_common:
{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

  deb_stable:
    - age
    - ansible-lint
    - bash-completion
    - debootstrap
    - fastfetch
    - fdisk
    - file
    - gpg
    - less
    - lsb-release
    - lsof
    - procps
    - psmisc
    - pwgen
    - stress
    - time
    - tree
    - whiptail

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

  xbps:
    - age
    - bash-completion
    - debootstrap
    - fastfetch
    - file
    - gnupg
    - gptfdisk
    - less
    - lsof
    - newt
    - procps-ng
    - psmisc
    - pwgen
    - python3-ansible-lint
    - stress
    - time
    - tree

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
