# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=yaml fdm=marker: */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

- name: RTFM | Installation
  tags: [packages, system, utilities, rtfm]
  become: true
  when: ansible_facts['os_family'] == 'Debian'
  block:

    - name: RTFM | Install packages (stable)
      ansible.builtin.apt:
        package: "{{ vbd_utilities_pkgs_rtfm.deb_stable }}"
        state: present
        install_recommends: false

    - name: RTFM | Install packages (backports)
      ansible.builtin.apt:
        package: "{{ vbd_utilities_pkgs_rtfm.deb_backports }}"
        default_release: "{{ ansible_facts['distribution_release'] }}-backports"
        state: latest # noqa: package-latest
        install_recommends: false
      when:
        - vbd_utilities_pkgs_rtfm.deb_backports is defined
        - vbd_utilities_pkgs_rtfm.deb_backports | length > 0

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

- name: RTFM | Install packages (xbps)
  tags: [packages, system, utilities, rtfm]
  become: true
  community.general.xbps:
    package: "{{ vbd_utilities_pkgs_rtfm.xbps }}"
    state: present
  when: ansible_facts['distribution'] == 'Void'

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
