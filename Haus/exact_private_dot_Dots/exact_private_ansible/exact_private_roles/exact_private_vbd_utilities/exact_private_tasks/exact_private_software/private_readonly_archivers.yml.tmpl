# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* {{{ Vim modeline for the template (YAML) */ -'@}
{@'- if false -'@}
# vim: set ft=yaml:
{@'- end -'@} {@'- /* }}} */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

- name: Archivers | Install packages (stable)
  tags: [packages, system, utilities, archivers]
  become: true
  ansible.builtin.apt:
    package: "{{ vbd_utilities_pkgs_archivers.deb_stable }}"
    state: present
    install_recommends: false
  when: ansible_facts['os_family'] == 'Debian'

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

- name: Archivers | Install packages (xbps)
  tags: [packages, system, utilities, archivers]
  become: true
  community.general.xbps:
    package: "{{ vbd_utilities_pkgs_archivers.xbps }}"
    state: present
  when: ansible_facts['distribution'] == 'Void'

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
