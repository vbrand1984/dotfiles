# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=yaml fdm=marker: */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

- name: Productivity utils | Installation
  become: true
  when: ansible_facts['os_family'] == 'Debian'
  block:

    - name: Productivity utils | Install packages (stable)
      ansible.builtin.apt:
        package: "{{ vbd_utilities_pkgs_productivity['deb_stable'] }}"
        state: present
        install_recommends: false

    - name: Productivity utils | Disable the ``rsync'' service
      ansible.builtin.service:
        name: rsync
        state: stopped
        enabled: false

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

- name: Productivity utils | Install packages (xbps)
  become: true
  community.general.xbps:
    package: "{{ vbd_utilities_pkgs_productivity['xbps'] }}"
    state: present
  when: ansible_facts['distribution'] == 'Void'

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
