# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=yaml fdm=marker: */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

- name: Debian-specific | Install packages
  when: ansible_facts['os_family'] == 'Debian'
  become: true
  block:

    - name: Debian-specific | Install packages (stable)
      ansible.builtin.apt:
        package: "{{ vbd_utilities_pkgs_distro_specific['deb_stable'] }}"
        state: present
        install_recommends: false

    - name: Debian-specific | Install packages (backports)
      ansible.builtin.apt:
        package: "{{ vbd_utilities_pkgs_distro_specific['deb_backports'] }}"
        default_release: "{{ ansible_facts['distribution_release'] }}-backports"
        state: latest # noqa: package-latest
        install_recommends: false

    - name: Debian-specific | Install the ``apt-file'' utility
      ansible.builtin.apt:
        package: apt-file
        state: present
        install_recommends: false
      register: __vbd_utilities_apt_file_installed

    - name: Debian-specific | Run ``apt-file update''
      ansible.builtin.command: apt-file update
      changed_when: true
      # In standard Debian install, apt-file is preinstalled,
      # so that previous task won't trigger handler
      when: > # noqa: no-handler
        __vbd_utilities_apt_file_installed.changed or
        ansible_facts['ansible_local']['vbd_system_setup'] is not defined or
        not ansible_facts['ansible_local']['vbd_system_setup']['completed']

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

- name: Void-specific | Install packages (xbps)
  become: true
  community.general.xbps:
    package: "{{ vbd_utilities_pkgs_distro_specific['xbps'] }}"
    state: present
  when: ansible_facts['distribution'] == 'Void'

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
