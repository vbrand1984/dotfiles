# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=yaml fdm=marker: */ -'@}

{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- /* {{{ Debian-based */'@}
{@'- if .sys.isDebianBased '@}

- name: Common utilities | Install packages (stable)
  become: true
  ansible.builtin.apt:
    package: "{{ vbd_utilities_pkgs_common['deb_stable'] }}"
    state: present
    install_recommends: false
  when: ansible_facts['os_family'] == 'Debian'

{@'- if not .sys.isDevuan '@}

- name: Common utilities | Install devuan-keyring
  become: true
  ansible.builtin.apt:
    deb: "{{ vbd_utilities_devuan_keyring_deb }}"
  when:
    - ansible_facts['os_family'] == 'Debian'
    - ansible_facts['distribution'] != 'Devuan'

{@'- end '@}

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

- name: Common utilities | Install packages (xbps)
  become: true
  community.general.xbps:
    package: "{{ vbd_utilities_pkgs_common['xbps'] }}"
    state: present
  when: ansible_facts['distribution'] == 'Void'

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
