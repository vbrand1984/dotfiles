    - ovmf
    - qemu-block-extra
    - qemu-system-modules-spice
    - qemu-system-x86
    - qemu-utils
    - virt-manager
    - virtiofsd

{@'- /* }}} */'@}
{@'- /* {{{ Void */'@}
{@'- else if .sys.isVoid '@}

  xbps:
    - edk2-ovmf
    - virt-manager

{@'- end '@} {@'- /* }}} */'@}

...
{@'- end '@}
