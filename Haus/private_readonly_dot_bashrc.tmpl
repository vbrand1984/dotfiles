# Quick clear screen
alias c='clear'

# Fastfetch
alias ff='fastfetch'

# htop
alias h='htop'

# Vim
alias v={@' .cmd.editor | squote '@}
alias se={@' (eq .cmd.sudo "/usr/bin/sudo" | ternary "sudoedit" "doas vim") | squote '@}

# Weather conditions and forecast
# "What's the forecast" alias
alias wtf='curl https://wttr.in/?M'

# Cheats
function cheat() { curl "cheat.sh/$1"; }

{@' if not .sys.isGentoo -'@}
# Coloured man pages for non-Gentoo distros
# Also, GROFF_NO_SGR=1 must be exported for that
# See: https://forum.endeavouros.com/t/coloured-man-pages/45375
alias man="/usr/bin/env LESS_TERMCAP_mb=\$'\e[1;36m' LESS_TERMCAP_md=\$'\e[1;36m' LESS_TERMCAP_me=\$'\e[0m' LESS_TERMCAP_se=\$'\e[0m' LESS_TERMCAP_so=\$'\e[30m\e[47m' LESS_TERMCAP_me=\$'\e[0m' LESS_TERMCAP_ue=\$'\e[0m' LESS_TERMCAP_us=\$'\e[4;33m' GROFF_NO_SGR=1 man {@'- if .sys.isVoid '@} -O width=$(( $(tput cols)-1 )) {@'- end '@}"

{@' end -'@}

{@' if and .sys.isDebianBased (lookPath "doas") -'@}
alias doas="{@' lookPath "doas" '@} {@' lookPath "env" '@} PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'"

{@' end -'@}

