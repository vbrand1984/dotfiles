# {{{ Generic intro

# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
	*i*) ;;
	  *) return;;
esac

# }}} (Generic intro)
# {{{ HISTCONTROL and other various settings

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL='ignoreboth:erasedups'

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=12000
HISTFILESIZE=8000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
#[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# I just sometimes love tabs btw
tabs -4

# }}} (HISTCONTROL)
# {{{ PS1: Command line prompt configuration

# See: https://www.learnlinux.tv/10-linux-terminal-tips-and-tricks-to-enhance-your-workflow/

{@'- /* {{{ Template variables definition */'@}

{@'- /* Load ANSI terminal color codes */'@}
{@'- $C := includeTemplate .tmpl.palette.ansiTerminalColors | fromYaml '@}
{@'- $B := $C.bold '@}

{@'- /* These color codes (without $C.esc.bashStart and $C.esc.bashStart) are used in dynamic functions in printf */'@}
{@'- $bracketColo :=		$B.green '@}
{@'- $branchCleanColo :=	$B.blue '@}
{@'- $branchDirtyColo :=	$B.yellow '@}
{@'- $exitCodeBad :=		$B.red '@}
{@'- $exitCodeOk :=			$B.blue '@}
{@'- $lineColo :=			$B.green '@}

{@'- /* These color codes (with $C.esc.bashStart and $C.esc.bashEnd) are used in PS1 directly */'@}
{@'- $bracketColour :=		print $C.esc.bashStart		$bracketColo	$C.esc.bashEnd '@}
{@'- $clockColour :=		print $C.esc.bashStart		$B.blue			$C.esc.bashEnd '@}
{@'- $distroColour :=		print $C.esc.bashStart		$B.cyan			$C.esc.bashEnd '@}
{@'- $endCharacterColour :=	print $C.esc.bashStart		$B.green		$C.esc.bashEnd '@}
{@'- $jobColour :=			print $C.esc.bashStart		$B.blue			$C.esc.bashEnd '@}
{@'- $lineColour :=			print $C.esc.bashStart		$lineColo		$C.esc.bashEnd '@}
{@'- $pathColour :=			print $C.esc.bashStart		$B.blue			$C.esc.bashEnd '@}
{@'- $usernameColour :=		print $C.esc.bashStart		$B.cyan			$C.esc.bashEnd '@}

{@'- /* Box characters to be used in the prompt */'@}
{@'- $lineBottomCorner :=	`\342\224\224` '@}
{@'- $lineUpperCorner :=	`\342\224\214` '@}
{@'- $lineStraight :=		`\342\224\200` '@}

{@'- /* Special symbols */'@}
{@'- $endCharacter :=		`\$` '@}
{@'- $gitBranchSymbol :=	`` '@}

{@'- /* }}} */'@}

# If inside a git working tree, print current git branch in the bottom line of the command prompt
function VBD_Print_Git_Branch() {
	if git rev-parse --is-inside-work-tree 1>/dev/null 2>&1 ; then 
		local branch_colo
		# Check if there are changes in the local repo and choose color of the branch name accordingly
		# See: https://stackoverflow.com/a/5148851
		if git diff-files --quiet --ignore-submodules 1>/dev/null 2>&1 ; then
			# No changes in the repository. The repo is "clean".
			branch_colo={@' $branchCleanColo | squote '@}
		else
			# Untracked changes are present. The repo is "dirty".
			branch_colo={@' $branchDirtyColo | squote '@}
		fi
		printf {@' print `"` $C.esc.start $bracketColo $C.esc.end "["
			$C.esc.start "${branch_colo}" $C.esc.end $gitBranchSymbol "$(git branch --show-current)"
			$C.esc.start $bracketColo $C.esc.end "]" $C.esc.start $lineColo $C.esc.end $lineStraight `"` '@}
	fi
}

# Print exit code. This function should be called from inside brackets 
function VBD_Print_Exit_Code() {
	local exit_code=$?
	if [[ $exit_code -eq 0 ]] ; then
		printf {@' print $C.esc.start $exitCodeOk $C.esc.end "0" | squote '@}
	else
		printf {@' print $C.esc.start $exitCodeBad $C.esc.end "%i" | squote '@} $exit_code
	fi
}

if [[ $TERM == 'linux' ]] ; then
	distro_logo={@' .chezmoi.osRelease.id | squote '@}
else
	distro_logo={@' includeTemplate "distro-logo.tmpl" . | squote '@}
fi

PS1={@' print
	$lineColour $lineUpperCorner $lineStraight $lineStraight
	$bracketColour "(" $distroColour `'"$distro_logo"'` $bracketColour ")" $lineColour $lineStraight
	$bracketColour "[" $usernameColour `\u@\h ` $pathColour `\w` $bracketColour "]" $C.reset `\n`
	$lineColour $lineBottomCorner $lineStraight $lineStraight
	$bracketColour "(" `$(VBD_Print_Exit_Code)` $bracketColour ")" $lineColour $lineStraight `$(VBD_Print_Git_Branch)`
	$bracketColour "[" $clockColour `\t` $bracketColour "]" $lineColour $lineStraight
	$endCharacterColour $endCharacter $C.esc.bashStart "$(tput sgr0)" $C.esc.bashEnd " "
	| squote
'@}

unset distro_logo

# If this is a graphical terminal, then set the window title to 'user@host: dir'
# The list of conditions is borrowed from Gentoo's global bash config
case "$TERM" in
	alacritty	  |\
	foot*		  |\
	rxvt-unicode* |\
	screen*		  |\
	st-256color   |\
	tmux*		  |\
	xterm*		  )
		PS1="\[\e]0;\u@\h: \w\a\]$PS1"
		;;
	*)
		;;
esac

# }}} (PS1)
# {{{ Aliases

# {{{ Generic aliases

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
	# We do not have the ~/.dircolors file
	#test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
	alias ls='ls --color=auto --group-directories-first'
	alias dir='dir --color=auto --group-directories-first'
	alias vdir='vdir --color=auto --group-directories-first'

	alias grep='grep --color=auto'
	alias fgrep='fgrep --color=auto'
	alias egrep='egrep --color=auto'
fi

# some more ls aliases
alias ll='ls -l --group-directories-first'
alias la='ls -Al --group-directories-first'
alias l='ls -CF --group-directories-first'

# Wrap the following commands for interactive use to avoid accidental file overwrites.
function rm() { command rm -I --preserve-root "${@}"; }
function cp() { command cp -i "${@}"; }
function mv() { command mv -i "${@}"; }

# }}} (Generic aliases)
