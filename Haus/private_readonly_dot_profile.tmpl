# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- /* vim: set ft=sh: */ -'@}

{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}

# This file is sourced by bash for login shells.  The following line
# runs your .bashrc and is recommended by the bash info pages.
if [ -n "${BASH_VERSION}" ]; then
	# Include ~/.bashrc if it exists
	[ -r "${HOME}/.bashrc" ] && . "${HOME}/.bashrc"
fi

# Set PATH so it includes user's private bin if it exists
[ -d {@' joinPath .chezmoi.homeDir .dir.localBin | shellQuote '@} ] && PATH="${PATH}:{@' joinPath .chezmoi.homeDir .dir.localBin '@}"
{@'- if .sys.isBrandsPrivate '@}
# ...and also user's private games...
[ -d {@' joinPath .chezmoi.homeDir .dir.localGames | shellQuote '@} ] && PATH="${PATH}:{@' joinPath .chezmoi.homeDir .dir.localGames '@}"
{@'- end '@}
