# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@' if .sys.isDebianBased -'@}

- name: Desktop Install | Update Apt Cache
  become: true
  become_user: root
  ansible.builtin.apt:
    upgrade: 'no'
    update-cache: true
    install_recommends: false
    autoclean: false
    autoremove: false
  diff: true
  tags: always

{@'- else if .sys.isVoid -'@}

- name: Desktop Install | Update Xbps Cache
  become: true
  become_user: root
  community.general.xbps:
    update_cache: true
    upgrade_xbps: true
  diff: true
  tags: always

{@'- end '@}

...
{@'- end '@}
