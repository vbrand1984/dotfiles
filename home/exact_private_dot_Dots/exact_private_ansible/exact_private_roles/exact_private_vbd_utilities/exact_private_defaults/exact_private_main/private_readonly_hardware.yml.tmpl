# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@'- if false -'@}
# vim: set ft=yaml:
{@'- end -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

vbd_utilities_pkgs_hardware:
{@'- if .sys.isDebianBased '@}
{@'- /* {{{ Debian-based */'@}

  stable:
    - cpuid
    - cpuinfo
    - dmidecode
    - hwinfo
    - inxi
    - lshw
    - lsscsi
    - pciutils
    - usbutils

{@'- /* }}} */'@}
{@'- else if .sys.isVoid '@}
{@'- /* {{{ Void */'@}

  xbps:
    - cpuid
    - cpuinfo
    - dmidecode
    - hwinfo
    - inxi
    - lshw
    - lsscsi
    - pciutils
    - usbutils

{@'- /* }}} */'@}
{@'- end '@}

...
{@'- end '@}
