# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- if false -'@}
# vim: set ft=yaml:
{@'- end -'@}
{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- if .sys.isDebianBased '@}
{@'- /* {{{ Debian-based */'@}

- name: System monitors | Install packages (stable)
  tags: [packages, system, utilities, system_monitors]
  become: true
  ansible.builtin.apt:
    package: "{{ vbd_utilities_pkgs_system_monitors.stable }}"
    state: latest
    install_recommends: false

- name: System monitors | Stop and disable `glances' service
  tags: [packages, system, utilities, system_monitors]
  ansible.builtin.service:
    name: glances
    state: stopped
    enabled: false

{@'- /* }}} */'@}
{@'- else if .sys.isVoid '@}
{@'- /* {{{ Void */'@}

- name: System monitors | Install packages (xbps)
  tags: [packages, system, utilities, system_monitors]
  become: true
  community.general.xbps:
    package: "{{ vbd_utilities_pkgs_system_monitors.xbps }}"
    state: present

{@'- /* }}} */'@}
{@'- end '@}

...
{@'- end '@}
