# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- if false -'@}
# vim: set ft=yaml:
{@'- end -'@}
{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- if .sys.isDebianBased '@}
{@'- /* {{{ Debian-based */'@}

- name: Network utils | Installation
  tags: [packages, system, utilities, network, network_utils]
  become: true
  when: ansible_facts['os_family'] == 'Debian'
  block:

    - name: Network utils | Install packages (stable)
      ansible.builtin.apt:
        package: "{{ vbd_utilities_pkgs_network_utils.deb_stable }}"
        state: latest
        install_recommends: false

    - name: Network utils | Install packages (backports)
      ansible.builtin.apt:
        package: "{{ vbd_utilities_pkgs_network_utils.deb_backports }}"
        default_release: "{{ ansible_facts['distribution_release'] }}-backports"
        state: latest
        install_recommends: false

{@'- /* }}} */'@}
{@'- else if .sys.isVoid '@}
{@'- /* {{{ Void */'@}

- name: Network utils | Install packages (xbps)
  tags: [packages, system, utilities, network, network_utils]
  become: true
  community.general.xbps:
    package: "{{ vbd_utilities_pkgs_network_utils.xbps }}"
    state: present
  when: ansible_facts['distribution'] == 'Void'

{@'- /* }}} */'@}
{@'- end '@}

...
{@'- end '@}
