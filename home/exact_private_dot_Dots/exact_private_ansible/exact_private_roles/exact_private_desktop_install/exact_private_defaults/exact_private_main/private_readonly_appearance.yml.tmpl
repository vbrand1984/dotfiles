# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---
desktop_install_pkg_appearance:
{@'- if .sys.isDebianBased '@}
  stable:

    # Fonts
    - fonts-dejavu
    - fonts-dejavu-extra
    - fonts-freefont-otf
    - fonts-jetbrains-mono
    - fonts-liberation
    - fonts-liberation2
    - fonts-noto
    - fonts-noto-cjk
    - fonts-noto-color-emoji
    - fonts-paratype
    - fonts-roboto
    - fonts-ubuntu

    # Themes
    - gnome-themes-extra
    - gtk2-engines
    - mate-themes

    # Icons
    - breeze-icon-theme
    - dmz-cursor-theme
    - gnome-extra-icons
    - gnome-icon-theme
    - papirus-icon-theme
{@' end -'@}
...
{@'- end '@}
