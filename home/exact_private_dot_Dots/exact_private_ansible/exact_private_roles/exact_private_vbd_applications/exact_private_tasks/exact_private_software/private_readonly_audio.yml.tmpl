# chezmoi:template: left-delimiter={@' right-delimiter='@}
{@'- if false -'@}
# vim: set ft=yaml:
{@'- end -'@}
{@'- if or .sys.isDebianBased .sys.isVoid -'@}
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " '@}
---

{@'- if .sys.isDebianBased '@}
{@'- /* {{{ Debian-based */'@}

- name: Audio applications | Install packages (stable)
  tags: [packages, desktop, applications, audio]
  become: true
  ansible.builtin.apt:
    package: "{{ vbd_applications_pkgs_audio.stable }}"
    state: latest
    install_recommends: false

{@'- /* }}} */'@}
{@'- else if .sys.isVoid '@}
{@'- /* {{{ Void */'@}

- name: Audio applications | Install packages (xbps)
  tags: [packages, desktop, applications, audio]
  become: true
  community.general.xbps:
    package: "{{ vbd_applications_pkgs_audio.xbps }}"
    state: present

{@'- /* }}} */'@}
{@'- end '@}

...
{@'- end '@}
