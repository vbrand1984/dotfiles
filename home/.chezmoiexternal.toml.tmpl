# Obmenu-generator script
[{@' joinPath .dir.downloadedScripts .file.debiansObmenuGeneratorName | quote '@}]
	type= "archive-file"
	url = "https://github.com/trizen/obmenu-generator/archive/refs/tags/{@' .app.obmenuGeneratorVersion '@}.tar.gz"
	stripComponents = 1
	format = "tar.gz"
	path = "obmenu-generator"
	filter.command = "sed"
	filter.args = [ "s/perl//g" ]
	executable = false
	readonly = true
	private = true
	refreshPeriod = 0

{@' end '@}

{@' if and .sys.isDebianBased (not .sys.hasSystemd) '@}
# Pipewire-launcher script from Gentoo to be installed and used in Devuan
[{@' joinPath .dir.downloadedScripts .file.devuansPipewireLauncher | quote '@}]
	type = "file"
	url = "https://gitweb.gentoo.org/repo/gentoo.git/plain/media-video/pipewire/files/gentoo-pipewire-launcher.in-r4"
	checksum.sha512 = "a6c725af79128859ef05e8e42e5069b6da65b13feeb8137b99498eafef0a02c5718003c8e820b1a73f9e1789fd4153e45ab18a7221e628a9f0cbce83d13d66bf"
	checksum.size = 2851
	filter.command = "sed"
	filter.args = [ "s/@GENTOO_PORTAGE_EPREFIX@//g" ]
	refreshPeriod = 0
	executable = false
	readonly = true
	private = true
{@' end '@}

