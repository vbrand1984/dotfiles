{@' if and .sys.isBrandsPrivate .sys.isDesktopRig '@}
# Font with weather icons which is used in my python-powered conky weather widget
# Only used on my desktop rig
[".local/share/fonts/weathericons-regular-webfont.ttf"]
	type = "file"
	url = "https://github.com/erikflowers/weather-icons/raw/master/font/weathericons-regular-webfont.ttf"
	executable = false
	refreshPeriod = 0
{@' end '@}

# }}}
# {{{ Distro-specific

{@' if .sys.isDebBased '@}

# deadbeef package
{@' $deadbeefFileName := (printf .app.version.deadbeef.filenamePattern .app.version.deadbeef.ver .app.version.deadbeef.build) '@}
[{@' joinPath .dir.downloadedDeb $deadbeefFileName | quote '@}]
	type= "file"
	url = "https://sourceforge.net/projects/deadbeef/files/Builds/{@' .app.version.deadbeef.ver '@}/linux/{@' $deadbeefFileName '@}/download"
	checksum.sha512 = {@' .app.version.deadbeef.sha512 | quote '@}
	checksum.size = {@' .app.version.deadbeef.size '@}
	executable = false
	refreshPeriod = 0

