# chezmoi:template: left-delimiter={@' right-delimiter='@} missing-key=invalid
# vim: set ft=toml ts=4 sw=4 noet:
{@' if not (env .app.envIgnoreExternals) '@}
# {{{ General

# Vim plugin manager
[".vim/autoload/plug.vim"]
	type = "file"
	url = "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
	refreshPeriod = "168h"

# }}}
# {{{ Themes

# Our default GTK and Openbox themes:
# Greylooks, GreylooksGreen, GreylooksHuman, GreylooksOk, GreylooksPurple, GreylooksSand
{@' range .misc.greylooksThemes '@}
[".local/share/themes/{@' . '@}"]
	type = "archive"
	url = "https://github.com/vbrand1984/greylooks/archive/master.zip"
	format = "zip"
	exact = true
	stripComponents = 2
	include = ["greylooks-master/{@' . '@}/**"]
	refreshPeriod = "1680h"
{@' end '@}

# }}}
# {{{ Desktop Backgrounds

# Hercules as default wallpaper
[{@' joinPath .dir.desktop.localBackgrounds .file.defaultWallpaper | quote '@}]
	type = "file"
	url = "https://images.squarespace-cdn.com/content/v1/5ce71504c7259600017b8c37/1663017845570-N437I6Y5NLT3G8LWGK4W/AdobeStock_300989887+(1).jpeg"
	checksum.sha512 = "16c79d418c6d27149cc7c9db5c31e69cd2171be5266e39ac5744cd7ab9cc1a06e1eafeeab231d3c522a2d69c73ff7b5cbd6f60b747d958332c4c8badb0871d55"
	checksum.size = 587384
	executable = false
	readonly = false
	private = false
	refreshPeriod = 0

{@' if .sys.isBrandsPrivate '@}
# Victor Brand's personal wallpapers
[{@' joinPath .dir.desktop.brandsBackgrounds | quote '@}]
	type = "archive"
	url = "https://drive.google.com/uc?export=download&id=1v1OQQq8HyKBEVGz4BO7tiJwacrc2_w2x"
	format = "tar.zst"
	stripComponents = 1
	exact = true
	include = ["brands-desktop-wallpapers/*"]
	checksum.sha512 = "fd0fa4cc92314d44006c4f1a33323fdd20d5df7abbfbe05f6c56ef51cbbd2d8002d0603b3cef41ccd0603afb76dcd9a1199919e05cc00d5520dcadd94830f86d"
	checksum.size = 2682067
	refreshPeriod = "1680h"
{@' end '@}

