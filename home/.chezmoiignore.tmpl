**/*.swp
**/*.old

# Ignore local games directory if it's empty
{{ .dir.localGames }}
!{{ .dir.localGames }}/**

{{ if not .sys.isBrandsPrivate }}
	.config/age
	.config/git/credentials
	.config/gtk-3.0/bookmarks
	.config/user-dirs.conf
	.config/user-dirs.dirs
	.config/user-dirs.locale
	.java
	{{ .dir.private }}
	{{ joinPath .dir.ansible.home "vars/local-symlinks.yml" }}
	{{ joinPath .dir.localScripts "openweathermap-id.json" }}
{{ end }}


# `downloaded' directory handling
{{ if env .app.envIgnoreExternals }}

	# papirus-folders package for debian-based distros
	{{ if .sys.isDebianBased }}
		{{ joinPath .dir.downloaded (printf .file.papirusFolders.pattern .file.papirusFolders.ver) }}
	{{ end }}

	# Devuan keyring for non-Devuan distros
	{{ if not .sys.isDevuan }}
		{{ $devuanCurrent := (get .file.devuanKeyring .file.devuanKeyring.current) }}
		{{ joinPath .dir.downloaded (printf .file.devuanKeyring.pattern $devuanCurrent.ver) }} 
	{{ end }}

{{ end }}

