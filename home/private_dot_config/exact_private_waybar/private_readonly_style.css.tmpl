/*
{@' includeTemplate .tmpl.msg.managedByChezmoi . | comment " * " '@}
 */

/* {{{ The bar itself */

window#waybar {
	background-image: linear-gradient(#353331, #3b3937);
	color: #dbd7d2;
	text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.7);
	margin: 0px;
	padding: 0px 5px;
	border-bottom: 1px solid #2e2c2a;
}

/* }}} */
/* {{{ Tooltips */

tooltip {
	background-color: #eee0b1;
	border: 1px solid #ad974c;
	border-radius: 0px;
}

tooltip label {
	font-family: {@' .gtk.font.family | quote '@}, sans-serif;
	font-weight: normal;
	font-size: {@' .gtk.font.size | int '@}pt;
	padding: 2px 4px;
	color: #080808;
}

/* }}} */
/* {{{ Backgrounds and borders */

#clock,
#language,
#idle_inhibitor {
	background: transparent;
	border: 2px solid transparent;
	border-radius: 8px;
	padding: 0px 1px;
	margin: 0px;
}

#clock:hover,
#language:hover,
#idle_inhibitor:hover {
	background-color: #545352;
	border-color: #646362;
}

/* }}} */
/* {{{ Workspaces */

#workspaces {
	margin: 0px 3px 0px 5px;
	padding: 1px 0px;
	color: #dbd7d2;
}

#workspaces button {
	background-image: linear-gradient(to bottom, #454341 0%, #514f4c 33%, #373533 100%);
	padding: 1px 2px;
	margin: 2px 1px;
	font-family: Ubuntu;
	font-size: 12pt;
	font-weight: Bold;
/*	border: 1px solid #7a7774;*/
	border: 1px solid #696867;
	border-radius: 5px;
	color: #dbd7d2;
	min-width: 18px;
	min-height: 10px;
}

#workspaces button:hover {
	background-image: linear-gradient(to bottom, #4e4c4a 0%, #5c5a57 33%, #403e3c 100%);
}

#workspaces button.focused {
/*	background: linear-gradient(to bottom, #403e3c 0%, #2f2d2b 33%, #43413f 100%);*/
	text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.7);
/*	background: linear-gradient(to bottom, #6c6b6a 0%, #807f7e 33%, #626160 100%);*/
	/* 45.3 53.3 41.2 */
	background: linear-gradient(to bottom, #676665 0%, #7b7a79 33%, #5d5c5b 100%);
	border-color: #7d7c7b;
	color: #f0ede5;
}

/* }}} */
/* {{{ Window */

#window {
	font-family: "Roboto";
	font-size: 12pt;
	font-weight: bold;
	color: #dbd7d2;
}

/* }}} */
/* {{{ Tray */

#tray {
	text-shadow: 0px 0px;
}

#tray widget>image {
	padding: 0px 2px;
}

/* }}} */
/* {{{ Pulseaudio */

#pulseaudio {
	padding: 0px 1px;
	font-size: 12pt;
	font-family: "Ubuntu Nerd Font";
	font-feature-settings: "tnum";
	font-weight: bold;
}

/* }}} */
/* {{{ Idle_inhibitor */

#idle_inhibitor {
	font-family: "Ubuntu Nerd Font";
	font-size: 12pt;
	font-weight: bold;
	font-feature-settings: "tnum";
	color: #dbd7d2;
}

/* }}} */
/* {{{ Language */

#language {
	padding: 0px 2px;
	font-size: 13pt;
	font-family: "JetBrainsMonoNL Nerd Font Mono", monospace;
	font-weight: 800; /* ExtraBold */
	font-feature-settings: "tnum";
	color: #dbd7d2;
}

/* }}} */
/* {{{ Clock */

#clock {
	padding: 0px 3px;
	margin-right: 5px;
	font-size: 12pt;
	font-family: Roboto;
	font-weight: 900; /* Black */
	font-feature-settings: "tnum";
	color: #dbd7d2;
}

/* }}} */
