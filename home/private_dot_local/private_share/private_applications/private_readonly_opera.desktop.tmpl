{{ includeTemplate .tmpl.msg.managedByChezmoi . | comment "# " }}
#

{{ $params := includeTemplate .tmpl.chromiumFlags (dict "app" "opera" "userid" .chezmoi.uid "useWayland" .sys.useWayland) | fromYaml | join " " -}}

[Desktop Entry]
Version=1.0
Name=Opera
GenericName=Web browser
Comment=Fast and secure web browser
TryExec=opera
Exec=opera {{ $params }} %U
Terminal=false
Icon=opera
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml_xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/ftp;application/x-opera-download;
Actions=new-window;new-private-window;
StartupWMClass=Opera

[Desktop Action new-window]
Name=New Window
Exec=opera {{ $params }} --new-window
X-TargetEnvironment=Unity

[Desktop Action new-private-window]
Name=New Private Window
Exec=opera {{ $params }} --incognito
X-TargetEnvironment=Unity
